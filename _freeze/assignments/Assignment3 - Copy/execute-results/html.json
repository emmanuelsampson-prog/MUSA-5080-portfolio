 = poverty_rate_moe / poverty_rate * 100)\n\npoverty_2010 <- poverty_2010 %>%\n  mutate(reliability = case_when(\n    moe_pct < 12  ~ \"Reliable\",\n    moe_pct < 40 ~ \"Somewhat reliable\",\n    TRUE         ~ \"Unreliable\"\n  ))\n```\n:::\n\n\n::: {.cell}\n\n```{.r .cell-code}\npoverty_2017 <- poverty_2017 %>%\n  mutate(moe_pct = poverty_rate_moe / poverty_rate * 100)\n\npoverty_2017 <- poverty_2017 %>%\n  mutate(reliability = case_when(\n    moe_pct < 12  ~ \"Reliable\",\n    moe_pct < 40 ~ \"Somewhat reliable\",\n    TRUE         ~ \"Unreliable\"\n  ))\n```\n:::\n\n\n::: {.cell}\n\n```{.r .cell-code}\npoverty_2010 <- poverty_2010 %>%\n  mutate(period = \"2006-2010\")\n\npoverty_2017 <- poverty_2017 %>%\n  mutate(period = \"2013-2017\")\n```\n:::\n\n\n::: {.cell}\n\n```{.r .cell-code}\npoverty_change <- bind_rows(\n  poverty_2010,\n  poverty_2017\n)\n```\n:::\n\n\n::: {.cell}\n\n```{.r .cell-code}\n  poverty_wide <- poverty_change %>%\n  select(\n    GEOID,\n    NAME,\n    period,\n    poverty_rate,\n    poverty_rate_moe\n  ) %>%\n  pivot_wider(\n    names_from = period,\n    values_from = c(\n      poverty_rate,\n      poverty_rate_moe\n    )\n  )\n```\n:::\n\n",
